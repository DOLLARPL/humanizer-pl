# Copy to .env and fill in. Nothing here is a real credential.

# Directory with style cards (JSON/Markdown). Defaults to the vault path the
# author uses; the repository ships synthetic cards in examples/style-cards.
HUMANIZER_STYL_DIR=

# HTTP service bind address and port.
HUMANIZER_HOST=127.0.0.1
HUMANIZER_PORT=8011

# Optional bearer token required by /zapisz and /zatwierdz. Empty means the
# service accepts local calls without authentication.
HUMANIZER_TOKEN=
